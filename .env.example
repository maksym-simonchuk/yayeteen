# ============================================================
# «Я Є» — Environment Variables
# Скопіювати у .env.local і заповнити реальними значеннями.
# НІКОЛИ не комітити .env.local у git.
# ============================================================

# --- Supabase (EU Frankfurt region) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Чат: claude-haiku-4-5 (найдешевша). Production: prompt caching.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_PROMPT_VERSION=v1.8

# --- App URLs ---
NEXT_PUBLIC_TEEN_APP_URL=http://localhost:3000
NEXT_PUBLIC_THERAPISTS_APP_URL=http://localhost:3001

# --- PostHog (EU self-hosted або Plausible) ---
# НЕ використовувати Google Analytics або Facebook Pixel
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-eu-host.com

# --- Sentry (EU self-hosted) ---
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.example.com/...
SENTRY_AUTH_TOKEN=sntrys_...

# --- Session ownership (P0-5, docs/quality-gate.md) ---
# Секрет для HMAC-підпису анонімних session-cookie. ОБОВ'ЯЗКОВИЙ у production
# (без нього API відповідає 500 — fail closed). Згенерувати: openssl rand -hex 32
SESSION_TOKEN_SECRET=

# --- Crisis safety ---
# Email команди безпеки (для crisis queue)
CRISIS_REVIEWER_EMAIL=reviewer@ya-ye.app
