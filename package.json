    "dup": "jscpd .",
    "budget": "node scripts/check-bundle-budget.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "dependency-cruiser": "^16.4.0",
    "knip": "^5.35.0",
    "jscpd": "^4.0.4"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=6.0.3",
      "vite": ">=6.4.2 <8",
      "tmp": ">=0.2.6",
      "postcss": ">=8.5.10",
      "@lhci/cli>uuid": ">=11.1.1 <12"
    }
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
